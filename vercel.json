{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/zh",
      "destination": "/zh.html"
    },
    {
      "source": "/zh/",
      "destination": "/zh.html"
    },
    {
      "source": "/zh/pdf-to-dwg",
      "destination": "/zh-pdf-to-dwg.html"
    },
    {
      "source": "/pdf-to-dwg",
      "destination": "/pdf-to-dwg.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/pdf-to-dwg",
      "destination": "/pdf-to-dwg",
      "permanent": true
    },
    {
      "source": "/en/pdf-to-dxf",
      "destination": "/pdf-to-dwg",
      "permanent": true
    },
    {
      "source": "/pdf-to-dxf",
      "destination": "/pdf-to-dwg",
      "permanent": true
    },
    {
      "source": "/pdf-to-dxf.html",
      "destination": "/pdf-to-dwg",
      "permanent": true
    },
    {
      "source": "/zh/pdf-to-dxf",
      "destination": "/zh/pdf-to-dwg",
      "permanent": true
    }
  ]
}
